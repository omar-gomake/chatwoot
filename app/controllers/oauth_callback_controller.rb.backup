class OauthCallbackController < ApplicationController
  def show
    @response = oauth_client.auth_code.get_token(
      oauth_code,
      redirect_uri: "#{base_url}/#{provider_name}/callback"
    )

    handle_response
  rescue StandardError => e
    ChatwootExceptionTracker.new(e).capture_exception
    Rails.logger.error "OAuth Callback Error: #{e.message}"
    Rails.logger.error "Backtrace: #{e.backtrace.join("\n")}"
    redirect_to '/'
  end

  private

  def handle_response
    inbox, already_exists = find_or_create_inbox

    # Use frontend_url from state if available, otherwise fallback to ENV
    frontend_base_url = @frontend_url || ENV.fetch('FRONTEND_URL', 'http://localhost:3000')
    
    Rails.logger.info "OAuth Callback - Frontend URL from state: #{@frontend_url}"
    Rails.logger.info "OAuth Callback - Final redirect URL: #{frontend_base_url}"
    Rails.logger.info "OAuth Callback - Account ID: #{account.id}"
    Rails.logger.info "OAuth Callback - Inbox ID: #{inbox.id}"

    if already_exists
      redirect_to "#{frontend_base_url}/app/accounts/#{account.id}/settings/inboxes/#{inbox.id}"
    else
      redirect_to "#{frontend_base_url}/app/accounts/#{account.id}/settings/inboxes/new/#{inbox.id}/agents"
    end
  end

  def find_or_create_inbox
    channel_email = find_channel_by_email
    # we need this value to know where to redirect on sucessful processing of the callback
    channel_exists = channel_email.present?

    channel_email ||= create_channel_with_inbox
    update_channel(channel_email)

    # reauthorize channel, this code path only triggers when microsoft auth is successful
    # reauthorized will also update cache keys for the associated inbox
    channel_email.reauthorized!

    [channel_email.inbox, channel_exists]
  end

  def find_channel_by_email
    Channel::Email.find_by(email: users_data['email'], account: account)
  end

  def update_channel(channel_email)
    channel_email.update!({
                            imap_login: users_data['email'], imap_address: imap_address,
                            imap_port: '993', imap_enabled: true,
                            provider: provider_name,
                            provider_config: {
                              access_token: parsed_body['access_token'],
                              refresh_token: parsed_body['refresh_token'],
                              expires_on: (Time.current.utc + 1.hour).to_s
                            }
                          })
  end

  def provider_name
    raise NotImplementedError
  end

  def oauth_client
    raise NotImplementedError
  end

  def create_channel_with_inbox
    ActiveRecord::Base.transaction do
      channel_email = Channel::Email.create!(email: users_data['email'], account: account)

      account.inboxes.create!(
        account: account,
        channel: channel_email,
        name: users_data['name'] || fallback_name
      )
      channel_email
    end
  end

  def users_data
    decoded_token = JWT.decode parsed_body[:id_token], nil, false
    decoded_token[0]
  end

  def account_from_signed_id
    raise ActionController::BadRequest, 'Missing state variable' if params[:state].blank?

    Rails.logger.info "OAuth Callback - State parameter: #{params[:state]}"

    begin
      # Try to decode state as new format (with frontend_url)
      state_data = Rails.application.message_verifier('oauth_state').verify(params[:state])
      
      Rails.logger.info "OAuth Callback - Decoded state data: #{state_data.inspect}"
      
      # Extract frontend_url and account
      @frontend_url = state_data[:frontend_url] || state_data['frontend_url']
      account = Account.find(state_data[:account_id] || state_data['account_id'])
      
      Rails.logger.info "OAuth Callback - Extracted frontend_url: #{@frontend_url}"
      Rails.logger.info "OAuth Callback - Extracted account_id: #{account.id}"
      
      raise 'Invalid or expired state' if account.nil?
      account
    rescue ActiveSupport::MessageVerifier::InvalidSignature, JSON::ParserError => e
      # Fallback to old format (GlobalID) for backward compatibility
      Rails.logger.info "OAuth Callback - State decode failed, trying old format: #{e.message}"
      account = GlobalID::Locator.locate_signed(params[:state])
      raise 'Invalid or expired state' if account.nil?
      
      account
    end
  end

  def account
    @account ||= account_from_signed_id
  end

  # Fallback name, for when name field is missing from users_data
  def fallback_name
    users_data['email'].split('@').first.parameterize.titleize
  end

  def oauth_code
    params[:code]
  end

  def base_url
    # Use frontend_url from state if available during OAuth flow
    # Otherwise use ENV variable
    @frontend_url || ENV.fetch('FRONTEND_URL', 'http://localhost:3000')
  end

  def parsed_body
    @parsed_body ||= @response.response.parsed
  end
end
